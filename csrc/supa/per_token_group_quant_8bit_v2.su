template <int THREADS_PER_SUBWARP>
__device__ __forceinline__ float GroupReduceMax(float val, const int tid) {
  unsigned mask = (1u << THREADS_PER_SUBWARP) - 1;

  static_assert(
      (THREADS_PER_SUBWARP & (THREADS_PER_SUBWARP - 1)) == 0 && THREADS_PER_SUBWARP <= 16 && THREADS_PER_SUBWARP >= 1,
      "THREADS_PER_SUBWARP must be 1, 2, 4, 8, or 16");

  if constexpr (THREADS_PER_SUBWARP >= 16) {
    val = fmaxf(val, __shfl_xor_sync(mask, val, 8));
  }
  if constexpr (THREADS_PER_SUBWARP >= 8) {
    val = fmaxf(val, __shfl_xor_sync(mask, val, 4));
  }
  if constexpr (THREADS_PER_SUBWARP >= 4) {
    val = fmaxf(val, __shfl_xor_sync(mask, val, 2));
  }
  if constexpr (THREADS_PER_SUBWARP >= 2) {
    val = fmaxf(val, __shfl_xor_sync(mask, val, 1));
  }
  return val;
}

// Generic fallback: scalar fp32 absmax over a thread's chunk
template <typename T, size_t NUM_PER_THREAD>
__device__ __forceinline__ float LocalAbsMax(const sute::array<T, NUM_PER_THREAD>& cached_input) {
  float local_absmax = fabsf(static_cast<float>(cached_input[0]));
#pragma unroll
  for (int32_t elem_idx = 1; elem_idx < (int32_t)NUM_PER_THREAD; elem_idx++) {
    local_absmax = fmaxf(local_absmax, fabsf(static_cast<float>(cached_input[elem_idx])));
  }
  return local_absmax;
}

// fp16 specialization: pair-wise __habs2 + __hmax2, then reduce across halves
template <size_t NUM_PER_THREAD>
__device__ __forceinline__ float LocalAbsMax(const sute::array<br_half, NUM_PER_THREAD>& cached_input) {
  static_assert((NUM_PER_THREAD % 2) == 0, "half2 absmax requires an even element count");
  __half2 local_absmax2 = __habs2(__halves2half2(cached_input[0], cached_input[1]));
#pragma unroll
  for (int32_t elem_idx = 2; elem_idx < (int32_t)NUM_PER_THREAD; elem_idx += 2) {
    __half2 vals2 = __halves2half2(cached_input[elem_idx], cached_input[elem_idx + 1]);
    local_absmax2 = __hmax2(local_absmax2, __habs2(vals2));
  }
  __half local_absmax = __hmax(__low2half(local_absmax2), __high2half(local_absmax2));
  return static_cast<float>(local_absmax);
}

// bf16 specialization: pair-wise __habs2 + __hmax2 on __br_bfloat162
template <size_t NUM_PER_THREAD>
__device__ __forceinline__ float LocalAbsMax(const sute::array<br_bfloat16, NUM_PER_THREAD>& cached_input) {
  static_assert((NUM_PER_THREAD % 2) == 0, "bfloat162 absmax requires an even element count");
  __br_bfloat162 local_absmax2 = __habs2(__halves2bfloat162(cached_input[0], cached_input[1]));
#pragma unroll
  for (int32_t elem_idx = 2; elem_idx < (int32_t)NUM_PER_THREAD; elem_idx += 2) {
    __br_bfloat162 vals2 = __halves2bfloat162(cached_input[elem_idx], cached_input[elem_idx + 1]);
    local_absmax2 = __hmax2(local_absmax2, __habs2(vals2));
  }
  __br_bfloat16 local_absmax = __hmax(__low2bfloat16(local_absmax2), __high2bfloat16(local_absmax2));
  return static_cast<float>(local_absmax);
}

__device__ __forceinline__ float silu_activation(const float& val) {
  return val / (1.0f + __expf(-val));
}

__forceinline__ __device__ float fast_pow2(int x) {
  uint32_t bits_x = (x + 127) << 23;
  return *reinterpret_cast<float*>(&bits_x);
}

__forceinline__ __device__ int fast_log2_ceil(float x) {
  auto bits_x = *reinterpret_cast<uint32_t*>(&x);
  auto exp_x = (bits_x >> 23) & 0xff;
  auto man_bits = bits_x & ((1 << 23) - 1);
  return exp_x - 127 + (man_bits != 0);
}

template <typename T>
struct DtypeInfo;

template <>
struct DtypeInfo<int8_t> {
  static constexpr float MIN = -128;
  static constexpr float MAX = 127;
};

template <>
struct DtypeInfo<__br_fp8_e4m3> {
  static constexpr float MIN = -448;
  static constexpr float MAX = 448;
};

template <bool ROUND_SCALE, typename dtype_info>
__forceinline__ __device__ void calculate_fp8_scales(float amax, float& scale, float& scale_inv) {
  constexpr float MAX_8BIT_INV = 1.0f / dtype_info::MAX;
  if constexpr (ROUND_SCALE) {
    auto exp_scale_inv = fast_log2_ceil(amax * MAX_8BIT_INV);
    scale = fast_pow2(-exp_scale_inv);
    scale_inv = fast_pow2(exp_scale_inv);
  } else {
    scale_inv = amax * MAX_8BIT_INV;
    scale = __frcp_rn(scale_inv);
  }
}

template <bool SCALE_UE8M0, typename OUT_DTYPE_T = std::conditional_t<SCALE_UE8M0, uint8_t, float>>
__forceinline__ __device__ OUT_DTYPE_T extract_required_scale_format(float value) {
  if constexpr (SCALE_UE8M0) {
    return static_cast<uint8_t>((*reinterpret_cast<uint32_t*>(&value)) >> 23);
  } else {
    return value;
  }
}

template <bool FUSE_SILU_AND_MUL>
__device__ __forceinline__ int64_t compute_input_group_start_offset(
    int expert_idx,
    int token_idx,
    int hidden_dim_group_idx,
    int hidden_size,
    int num_tokens_per_expert,
    int group_size) {
  // int64 math: E * num_tokens_per_expert * hidden_size * 2 overflows int32 on large
  // prefill (e.g. E=256, D=2048 -> hidden_size*2=4096, padded m in the thousands
  // exceeds INT_MAX=2.1e9), producing a negative offset and an illegal access.
  constexpr int fuse_mul = FUSE_SILU_AND_MUL ? 2 : 1;
  return static_cast<int64_t>(expert_idx) * num_tokens_per_expert * hidden_size * fuse_mul +
         static_cast<int64_t>(token_idx) * hidden_size * fuse_mul +
         static_cast<int64_t>(hidden_dim_group_idx) * group_size;
}

constexpr float LOCAL_ABSMAX_ABS = 1e-10;
constexpr uint32_t INPUT_PRIMARY_VEC_NUM_BYTES = 32;

struct NaiveScheduler {
  static void compute_exec_config(
      int threads_per_subwarp,
      int num_local_experts,
      int hidden_dim_num_groups,
      int num_groups,
      int /*num_tokens_per_expert*/,
      int& subwarps_per_block,
      dim3& grid,
      dim3& block) {
    // Opt5: scan up to 64 to fill more SUPA warp slots per block
    subwarps_per_block = ([=]() -> int {
      for (int sp : {64, 32, 16, 8, 4, 2, 1}) {
        if (num_groups % sp == 0) return sp;
      }
      return 1;
    })();
    grid = dim3(num_groups / subwarps_per_block);
    block = dim3(subwarps_per_block * threads_per_subwarp);
  }

  template <bool FUSE_SILU_AND_MUL, int GROUP_SIZE, int THREADS_PER_SUBWARP, typename FUNC>
  __device__ __forceinline__ static void execute(
      const int subwarps_per_block,
      const int hidden_dim_num_groups,
      const int32_t* masked_m,
      const int num_tokens_per_expert,
      FUNC fn) {
    constexpr int expert_idx = 0;

    const int64_t subwarp_id = threadIdx.x / THREADS_PER_SUBWARP;
    const int lane_id = threadIdx.x % THREADS_PER_SUBWARP;

    const int64_t block_group_id = blockIdx.x * subwarps_per_block;
    const int64_t group_id = block_group_id + subwarp_id;

    int64_t input_group_start_offset;
    if constexpr (!FUSE_SILU_AND_MUL) {
      input_group_start_offset = group_id * GROUP_SIZE;
    }

    const int token_idx = group_id / hidden_dim_num_groups;
    const int hidden_dim_group_idx = group_id % hidden_dim_num_groups;

    if constexpr (FUSE_SILU_AND_MUL) {
      const int hidden_size = hidden_dim_num_groups * GROUP_SIZE;
      input_group_start_offset = compute_input_group_start_offset<FUSE_SILU_AND_MUL>(
          expert_idx, token_idx, hidden_dim_group_idx, hidden_size, num_tokens_per_expert, GROUP_SIZE);
    }

    fn(expert_idx, token_idx, hidden_dim_group_idx, lane_id, input_group_start_offset);
  }
};

struct MaskedLayoutScheduler {
  // Original (upstream) masked scheduler. Kept unchanged for the ue8m0
  // (Blackwell) path so that path's launch config / behavior is untouched.
  static constexpr int TOKEN_DIM_BLOCK_NUM_PER_EXPERT = 1024;
  static constexpr int SUBWARPS_PER_BLOCK = 16;

  static void compute_exec_config(
      int threads_per_subwarp,
      int num_local_experts,
      int hidden_dim_num_groups,
      int num_groups,
      int /*num_tokens_per_expert*/,
      int& subwarps_per_block,
      dim3& grid,
      dim3& block) {
    subwarps_per_block = SUBWARPS_PER_BLOCK;
    TORCH_CHECK(hidden_dim_num_groups % subwarps_per_block == 0);
    grid = dim3(hidden_dim_num_groups / subwarps_per_block, TOKEN_DIM_BLOCK_NUM_PER_EXPERT, num_local_experts);
    block = dim3(subwarps_per_block * threads_per_subwarp);
  }

  template <bool FUSE_SILU_AND_MUL, int GROUP_SIZE, int THREADS_PER_SUBWARP, typename FUNC>
  __device__ __forceinline__ static void execute(
      const int subwarps_per_block,
      const int hidden_dim_num_groups,
      const int32_t* masked_m,
      const int num_tokens_per_expert,
      FUNC fn) {
    const int64_t subwarp_id = threadIdx.x / THREADS_PER_SUBWARP;
    const int lane_id = threadIdx.x % THREADS_PER_SUBWARP;

    const int expert_idx = blockIdx.z;
    const int token_idx_start = blockIdx.y;

    const int64_t hidden_dim_group_idx = blockIdx.x * SUBWARPS_PER_BLOCK + subwarp_id;

    const int curr_expert_token_num = masked_m[expert_idx];

    for (int token_idx = token_idx_start; token_idx < curr_expert_token_num;
         token_idx += TOKEN_DIM_BLOCK_NUM_PER_EXPERT) {
      const int hidden_size = hidden_dim_num_groups * GROUP_SIZE;
      const int64_t input_group_start_offset = compute_input_group_start_offset<FUSE_SILU_AND_MUL>(
          expert_idx, token_idx, hidden_dim_group_idx, hidden_size, num_tokens_per_expert, GROUP_SIZE);
      fn(expert_idx, token_idx, hidden_dim_group_idx, lane_id, input_group_start_offset);
    }
  }
};

struct MaskedLayoutSchedulerFlat {
  static constexpr int SUBWARPS_PER_BLOCK = 16;  // 16 subwarps -> full 128-thread block

  static void compute_exec_config(
      int threads_per_subwarp,
      int num_local_experts,
      int hidden_dim_num_groups,
      int num_groups,
      int num_tokens_per_expert,
      int& subwarps_per_block,
      dim3& grid,
      dim3& block) {
    // Each subwarp handles one flattened (token, hidden_group) work-item, so the
    // block is always a full 128 threads (16 subwarps) regardless of
    // hidden_dim_num_groups -- avoids the half-warp 16-thread block that a
    // subwarp==hidden_group mapping produces for small G (e.g. GLM TP8 gives G=2).
    // Used by the non-ue8m0 masked+fuse path only.
    //
    // grid.x is bounded by the *expected* item count (not the padded capacity):
    // expected_m ~ num_tokens_per_expert / 32 for typical MoE (top_k/num_experts
    // ~ 1/32); expected_items = expected_m * hidden_dim_num_groups. A grid-stride
    // loop in execute() then covers each expert's actual masked_m*G items, so the
    // grid tracks real work rather than the m_max padding.
    subwarps_per_block = SUBWARPS_PER_BLOCK;
    int expected_m = num_tokens_per_expert / 32;
    if (expected_m < 1) {
      expected_m = 1;
    }
    const int64_t expected_items = static_cast<int64_t>(expected_m) * hidden_dim_num_groups;
    int item_blocks = static_cast<int>((expected_items + SUBWARPS_PER_BLOCK - 1) / SUBWARPS_PER_BLOCK);
    if (item_blocks < 1) {
      item_blocks = 1;
    }
    const int item_blocks_cap = 8192;
    if (item_blocks > item_blocks_cap) {
      item_blocks = item_blocks_cap;
    }
    grid = dim3(static_cast<unsigned>(item_blocks), 1, num_local_experts);
    block = dim3(subwarps_per_block * threads_per_subwarp);
  }

  template <bool FUSE_SILU_AND_MUL, int GROUP_SIZE, int THREADS_PER_SUBWARP, typename FUNC>
  __device__ __forceinline__ static void execute(
      const int subwarps_per_block,
      const int hidden_dim_num_groups,
      const int32_t* masked_m,
      const int num_tokens_per_expert,
      FUNC fn) {
    const int subwarp_id = threadIdx.x / THREADS_PER_SUBWARP;
    const int lane_id = threadIdx.x % THREADS_PER_SUBWARP;

    const int expert_idx = blockIdx.z;
    const int64_t total_items = static_cast<int64_t>(masked_m[expert_idx]) * hidden_dim_num_groups;
    const int64_t stride = static_cast<int64_t>(gridDim.x) * SUBWARPS_PER_BLOCK;
    const int hidden_size = hidden_dim_num_groups * GROUP_SIZE;

    // Grid-stride over the flattened (token, hidden_group) item space of this
    // expert. total_items = masked_m[e] * G (actual work), not the padded m*G.
    for (int64_t item = static_cast<int64_t>(blockIdx.x) * SUBWARPS_PER_BLOCK + subwarp_id; item < total_items;
         item += stride) {
      const int token_idx = static_cast<int>(item / hidden_dim_num_groups);
      const int hidden_dim_group_idx = static_cast<int>(item % hidden_dim_num_groups);
      const int64_t input_group_start_offset = compute_input_group_start_offset<FUSE_SILU_AND_MUL>(
          expert_idx, token_idx, hidden_dim_group_idx, hidden_size, num_tokens_per_expert, GROUP_SIZE);
      fn(expert_idx, token_idx, hidden_dim_group_idx, lane_id, input_group_start_offset);
    }
  }
};

template <
    typename SCHEDULER,
    int GROUP_SIZE,
    int THREADS_PER_SUBWARP,
    typename T,
    typename DST_DTYPE,
    bool IS_COLUMN_MAJOR = false,
    bool SCALE_UE8M0 = false,
    bool FUSE_SILU_AND_MUL = false,
    bool INTERLEAVED_OUTPUT = false,
    typename scale_packed_t = std::conditional_t<SCALE_UE8M0, uint32_t, float>>
__global__ void per_token_group_quant_8bit_v2_kernel(
    const T* __restrict__ input,
    DST_DTYPE* __restrict__ output_q,
    scale_packed_t* __restrict__ output_s,
    const int32_t* __restrict__ masked_m,
    const int subwarps_per_block,
    const int hidden_dim_num_groups,
    const int scale_expert_stride,
    const int scale_hidden_stride,
    const int num_tokens_per_expert) {
  using dst_dtype_info = DtypeInfo<DST_DTYPE>;
  using scale_element_t = std::conditional_t<SCALE_UE8M0, uint8_t, float>;
  static_assert(sizeof(scale_packed_t) % sizeof(scale_element_t) == 0);

  constexpr uint32_t INPUT_PRIMARY_VEC_SIZE = INPUT_PRIMARY_VEC_NUM_BYTES / sizeof(T);

  SCHEDULER::template execute<FUSE_SILU_AND_MUL, GROUP_SIZE, THREADS_PER_SUBWARP>(
      subwarps_per_block,
      hidden_dim_num_groups,
      masked_m,
      num_tokens_per_expert,
      [&](const int expert_idx,
          const int token_idx,
          const int hidden_dim_group_idx,
          const int lane_id,
          const int64_t input_group_start_offset) {
        using InputArray = sute::array<T, INPUT_PRIMARY_VEC_SIZE>;
        using OutputArray = sute::array<DST_DTYPE, INPUT_PRIMARY_VEC_SIZE>;

        const int64_t offset_num_groups = static_cast<int64_t>(expert_idx) * num_tokens_per_expert * hidden_dim_num_groups +
                                           static_cast<int64_t>(token_idx) * hidden_dim_num_groups + hidden_dim_group_idx;

        InputArray input_primary_vec;
        sutlass::arch::global_load<InputArray, sizeof(InputArray)>(
            input_primary_vec, input + input_group_start_offset + lane_id * INPUT_PRIMARY_VEC_SIZE, true);

        InputArray input_secondary_vec;
        if constexpr (FUSE_SILU_AND_MUL) {
          const int secondary_offset = hidden_dim_num_groups * GROUP_SIZE;
          sutlass::arch::global_load<InputArray, sizeof(InputArray)>(
              input_secondary_vec,
              input + input_group_start_offset + lane_id * INPUT_PRIMARY_VEC_SIZE + secondary_offset,
              true);
        }

        constexpr int num_elems_per_pack = static_cast<int>(sizeof(scale_packed_t) / sizeof(scale_element_t));
        scale_element_t* scale_output;
        if constexpr (INTERLEAVED_OUTPUT) {
          // colMajor 16B Interleaved: write the single E8M0 byte for (token_idx,
          // hidden_dim_group_idx) directly into the layout sublasLt expects —
          // [tile0: m0..m15 @ g0, m0..m15 @ g1, ..., tile1, ...]. Eliminates the
          // host unpack+to_sublaslt_interleaved pass for the dense sublasLt path.
          static_assert(SCALE_UE8M0, "INTERLEAVED_OUTPUT requires SCALE_UE8M0");
          const int tile = token_idx / 16;
          const int local_m = token_idx % 16;
          scale_output = reinterpret_cast<uint8_t*>(output_s) +
                         (tile * 16 * hidden_dim_num_groups +
                          hidden_dim_group_idx * 16 + local_m);
        } else if constexpr (IS_COLUMN_MAJOR) {
          constexpr int scale_token_stride = 1;

          const int hidden_idx_packed = hidden_dim_group_idx / num_elems_per_pack;
          const int pack_idx = hidden_dim_group_idx % num_elems_per_pack;
          scale_output = reinterpret_cast<scale_element_t*>(output_s) +
                         (expert_idx * scale_expert_stride * num_elems_per_pack +
                          hidden_idx_packed * scale_hidden_stride * num_elems_per_pack +
                          token_idx * scale_token_stride * num_elems_per_pack + pack_idx);
        } else {
          // Row-major non-interleaved path.  Supports float scale (SCALE_UE8M0=false) or plain
          // uint8 E8M0 scale (SCALE_UE8M0=true with scale_packed_t=uint8_t, for MoE MXFP8 path
          // via fuse_silu_and_mul=true without masked_layout).
          static_assert(!SCALE_UE8M0 || std::is_same_v<scale_packed_t, uint8_t>);
          scale_output = reinterpret_cast<scale_element_t*>(output_s) + offset_num_groups;
        }

        if constexpr (IS_COLUMN_MAJOR and SCALE_UE8M0) {
          const int remainder_num_groups = hidden_dim_num_groups % num_elems_per_pack;
          if ((remainder_num_groups != 0) and (hidden_dim_group_idx == hidden_dim_num_groups - 1) and
              (lane_id < num_elems_per_pack - remainder_num_groups)) {
            const int shift = 1 + lane_id;
            *(scale_output + shift) = 0;
          }
        }

        // Opt8: separate silu+mul from absmax so both paths use SIMD LocalAbsMax
        // (FUSE previously used scalar fabsf loop; now triggers __habs2/__hmax2 specialization)
        if constexpr (FUSE_SILU_AND_MUL) {
#pragma unroll
          for (uint32_t j = 0; j < INPUT_PRIMARY_VEC_SIZE; ++j) {
            input_primary_vec[j] =
                static_cast<T>(silu_activation(static_cast<float>(input_primary_vec[j]))) * input_secondary_vec[j];
          }
        }
        float local_absmax = fmaxf(LocalAbsMax(input_primary_vec), LOCAL_ABSMAX_ABS);

        local_absmax = GroupReduceMax<THREADS_PER_SUBWARP>(local_absmax, lane_id);

        float y_scale, y_scale_inv;
        calculate_fp8_scales<SCALE_UE8M0, dst_dtype_info>(local_absmax, y_scale, y_scale_inv);

        if (lane_id == 0) {
          *scale_output = extract_required_scale_format<SCALE_UE8M0>(y_scale_inv);
        }

        OutputArray output_buf;

        if constexpr (std::is_same_v<DST_DTYPE, __br_fp8_e4m3>) {
          __br_fp8x2_storage_t* dst_fp8x2_ptr = reinterpret_cast<__br_fp8x2_storage_t*>(&output_buf);
#pragma unroll
          for (uint32_t j = 0; j < INPUT_PRIMARY_VEC_SIZE; j += 2) {
            float2 outputx2 = {
                static_cast<float>(input_primary_vec[j]) * y_scale,
                static_cast<float>(input_primary_vec[j + 1]) * y_scale};
            dst_fp8x2_ptr[j / 2] = __br_cvt_float2_to_fp8x2(outputx2, __BR_SATFINITE, __BR_E4M3);
          }
        } else {
#pragma unroll
          for (uint32_t j = 0; j < INPUT_PRIMARY_VEC_SIZE; ++j) {
            float val = static_cast<float>(input_primary_vec[j]);
            float q_val = fminf(fmaxf(val * y_scale, dst_dtype_info::MIN), dst_dtype_info::MAX);
            output_buf[j] = DST_DTYPE(q_val);
          }
        }

        sutlass::arch::global_store<OutputArray, sizeof(OutputArray)>(
            output_buf, output_q + offset_num_groups * GROUP_SIZE + lane_id * INPUT_PRIMARY_VEC_SIZE, true);
      });
}

void sgl_per_token_group_quant_8bit_v2(
    torch::Tensor input,
    torch::Tensor output_q,
    torch::Tensor output_s,
    int64_t group_size,
    double eps,
    double min_8bit,
    double max_8bit,
    bool scale_ue8m0,
    bool fuse_silu_and_mul,
    const std::optional<torch::Tensor>& masked_m) {
  CHECK_INPUT(input);
  CHECK_INPUT(output_q);
  TORCH_CHECK(input.numel() > 0);

  TORCH_CHECK(std::abs(LOCAL_ABSMAX_ABS - eps) < 1e-13);

  CHECK_EQ(input.numel() % group_size, 0);
  const int num_groups = static_cast<int>(input.numel()) / group_size / (fuse_silu_and_mul ? 2 : 1);

  const bool masked_layout = masked_m.has_value();
  TORCH_CHECK(output_s.dim() == (masked_layout ? 3 : 2));

  const int num_local_experts = masked_layout ? input.size(0) : 1;

  c10::supa::OptionalSUPAGuard device_guard(input.device());
  supaStream_t stream = c10::supa::getCurrentSUPAStream().stream();

  auto dst_type = output_q.scalar_type();

  const bool is_column_major = output_s.stride(-2) < output_s.stride(-1);
  const int hidden_dim_num_groups = static_cast<int>(output_q.size(-1)) / group_size;
  const int num_tokens_per_expert = static_cast<int>(output_q.size(-2));
  const int scale_expert_stride = masked_layout ? static_cast<int>(output_s.stride(0)) : 0;
  const int scale_hidden_stride = static_cast<int>(output_s.stride(-1));

#define LAUNCH_KERNEL_INNER(SCHEDULER, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, output_s_dtype, ...)      \
  do {                                                                                                          \
    int subwarps_per_block;                                                                                     \
    dim3 grid, block;                                                                                           \
    SCHEDULER::compute_exec_config(                                                                             \
        THREADS_PER_SUBWARP,                                                                                    \
        num_local_experts,                                                                                      \
        hidden_dim_num_groups,                                                                                  \
        num_groups,                                                                                             \
        num_tokens_per_expert,                                                                                  \
        subwarps_per_block,                                                                                     \
        grid,                                                                                                   \
        block);                                                                                                 \
                                                                                                                \
    per_token_group_quant_8bit_v2_kernel<SCHEDULER, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, __VA_ARGS__> \
        <<<grid, block, 0, stream>>>(                                                                           \
            static_cast<T*>(input.data_ptr()),                                                                  \
            static_cast<DST_DTYPE*>(output_q.data_ptr()),                                                       \
            static_cast<output_s_dtype*>(output_s.data_ptr()),                                                  \
            static_cast<int32_t*>(masked_m.has_value() ? masked_m->data_ptr() : 0),                             \
            subwarps_per_block,                                                                                 \
            hidden_dim_num_groups,                                                                              \
            scale_expert_stride,                                                                                \
            scale_hidden_stride,                                                                                \
            num_tokens_per_expert);                                                                             \
  } while (0)

#define LAUNCH_KERNEL(GROUP_SIZE, T, DST_DTYPE)                                                                     \
  do {                                                                                                              \
    constexpr int THREADS_PER_SUBWARP = GROUP_SIZE / 16;                                                            \
    TORCH_CHECK(THREADS_PER_SUBWARP * INPUT_PRIMARY_VEC_NUM_BYTES == group_size * sizeof(T));                       \
                                                                                                                    \
    using dst_dtype_info = DtypeInfo<DST_DTYPE>;                                                                    \
    CHECK_EQ(dst_dtype_info::MIN, min_8bit);                                                                        \
    CHECK_EQ(dst_dtype_info::MAX, max_8bit);                                                                        \
                                                                                                                    \
    if (is_column_major) {                                                                                          \
      if (scale_ue8m0) {                                                                                            \
        if (fuse_silu_and_mul) {                                                                                    \
          if (masked_layout) {                                                                                      \
            LAUNCH_KERNEL_INNER(                                                                                    \
                MaskedLayoutScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, uint32_t, true, true, true);  \
          } else {                                                                                                  \
            LAUNCH_KERNEL_INNER(                                                                                    \
                NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, uint32_t, true, true, true);         \
          }                                                                                                         \
        } else {                                                                                                    \
          LAUNCH_KERNEL_INNER(NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, uint32_t, true, true); \
        }                                                                                                           \
      } else {                                                                                                      \
        LAUNCH_KERNEL_INNER(NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, float, true);            \
      }                                                                                                             \
    } else {                                                                                                        \
      if (fuse_silu_and_mul && masked_layout) {                                                                     \
        LAUNCH_KERNEL_INNER(                                                                                        \
            MaskedLayoutSchedulerFlat, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, float, false, false, true);   \
      } else if (fuse_silu_and_mul && scale_ue8m0) {                                                               \
        /* Row-major plain uint8 E8M0 scale + fuse_silu_and_mul: MoE MXFP8 activation quant path. */              \
        /* scale_packed_t=uint8_t overrides the default (uint32_t) so the kernel writes 1 byte/group. */           \
        LAUNCH_KERNEL_INNER(NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, uint8_t, false, true, true, false, uint8_t); \
      } else if (scale_ue8m0) {                                                                                    \
        /* Row-major plain uint8 E8M0 scale, no fuse_silu_and_mul: GEMM1 activation quant in MoE MXFP8 path. */   \
        LAUNCH_KERNEL_INNER(NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, uint8_t, false, true, false, false, uint8_t); \
      } else {                                                                                                      \
        LAUNCH_KERNEL_INNER(NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE, float, false);           \
      }                                                                                                             \
    }                                                                                                               \
  } while (0)

#define LAUNCH_KERNEL_OUTER(...)                    \
  switch (group_size) {                             \
    case 16:                                        \
      LAUNCH_KERNEL(16, __VA_ARGS__);               \
      break;                                        \
    case 32:                                        \
      LAUNCH_KERNEL(32, __VA_ARGS__);               \
      break;                                        \
    case 64:                                        \
      LAUNCH_KERNEL(64, __VA_ARGS__);               \
      break;                                        \
    case 128:                                       \
      LAUNCH_KERNEL(128, __VA_ARGS__);              \
      break;                                        \
    default:                                        \
      TORCH_CHECK(false, "Unsupported group_size"); \
  }                                                 \
  while (0)

  DISPATCH_PYTORCH_DTYPE_TO_CTYPE_FP16(input.scalar_type(), scalar_t, [&] {
    if (dst_type == at::ScalarType::Char) {
      LAUNCH_KERNEL_OUTER(scalar_t, int8_t);
      return true;
    } else if (dst_type == at::ScalarType::Float8_e4m3fn) {
      LAUNCH_KERNEL_OUTER(scalar_t, __br_fp8_e4m3);
      return true;
    }
    return false;
  });

#undef LAUNCH_KERNEL_OUTER
#undef LAUNCH_KERNEL
#undef LAUNCH_KERNEL_INNER
}

// Fused activation quantization that writes the UE8M0 scale directly in the
// colMajor 16B Interleaved layout sublasLt (VEC32_UE8M0) expects, fusing the
// scale layout conversion into the quantization kernel. Used by the BR288
// MXFP8 dense GEMM path (supa_w8a8_mxfp8_linear_with_fallback) so the host no
// longer needs to unpack -> to_sublaslt_interleaved. The grouped-MOE path keeps
// the plain-layout sgl_per_token_group_quant_8bit_v2 (it interleaves internally).
//
// output_s must be a contiguous uint8 [M_padded, sfK] buffer where
// M_padded = ceil(M/16)*16 (>= M, multiple of 16) and sfK = K/group_size.
// Layout written: byte (token m, group g) at offset
//   (m/16)*16*sfK + g*16 + (m%16). Padded rows are untouched (stay zero).
void sgl_per_token_group_quant_8bit_v2_interleaved(
    torch::Tensor input,
    torch::Tensor output_q,
    torch::Tensor output_s,
    int64_t group_size,
    double eps,
    double min_8bit,
    double max_8bit,
    bool scale_ue8m0) {
  CHECK_INPUT(input);
  CHECK_INPUT(output_q);
  CHECK_INPUT(output_s);
  TORCH_CHECK(input.numel() > 0);
  TORCH_CHECK(input.dim() == 2, "input must be 2D [M, K]");

  TORCH_CHECK(std::abs(LOCAL_ABSMAX_ABS - eps) < 1e-13);

  CHECK_EQ(input.numel() % group_size, 0);

  TORCH_CHECK(scale_ue8m0, "interleaved emit requires scale_ue8m0=true");
  TORCH_CHECK(output_s.scalar_type() == at::ScalarType::Byte,
              "output_s must be uint8 (UE8M0 interleaved)");
  TORCH_CHECK(output_s.is_contiguous(), "output_s must be contiguous");
  TORCH_CHECK(output_s.dim() == 2, "output_s must be 2D [M_padded, sfK]");

  const int M = static_cast<int>(input.size(0));
  const int K = static_cast<int>(input.size(1));
  const int sfK = K / group_size;
  TORCH_CHECK(K % group_size == 0, "K must be divisible by group_size");
  TORCH_CHECK(output_s.size(1) == sfK, "output_s.size(1) must equal K/group_size");
  TORCH_CHECK(output_s.size(0) % 16 == 0, "output_s.size(0) (M_padded) must be a multiple of 16");
  TORCH_CHECK(output_s.size(0) >= M, "output_s.size(0) must be >= M (input rows)");
  TORCH_CHECK(output_s.size(0) >= 16, "output_s must hold at least one 16-row tile");

  const int num_groups = static_cast<int>(input.numel()) / group_size;
  const int hidden_dim_num_groups = sfK;
  const int num_tokens_per_expert = M;  // unused by NaiveScheduler (single-expert)
  const int scale_expert_stride = 0;     // unused: no expert dim
  const int scale_hidden_stride = 0;     // unused: interleaved offset ignores strides

  c10::supa::OptionalSUPAGuard device_guard(input.device());
  supaStream_t stream = c10::supa::getCurrentSUPAStream().stream();

  auto dst_type = output_q.scalar_type();

#define INTERLEAVED_LAUNCH_KERNEL_INNER(GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE)                        \
  do {                                                                                                        \
    int subwarps_per_block;                                                                                   \
    dim3 grid, block;                                                                                         \
    NaiveScheduler::compute_exec_config(                                                                     \
        THREADS_PER_SUBWARP, 1, hidden_dim_num_groups, num_groups, num_tokens_per_expert, subwarps_per_block, grid, block);          \
    per_token_group_quant_8bit_v2_kernel<                                                                     \
        NaiveScheduler, GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE,                                        \
        /*IS_COLUMN_MAJOR=*/false, /*SCALE_UE8M0=*/true, /*FUSE_SILU_AND_MUL=*/false,                         \
        /*INTERLEAVED_OUTPUT=*/true>                                                                          \
        <<<grid, block, 0, stream>>>(                                                                         \
            static_cast<T*>(input.data_ptr()),                                                                \
            static_cast<DST_DTYPE*>(output_q.data_ptr()),                                                     \
            static_cast<uint32_t*>(output_s.data_ptr()),                                                      \
            /*masked_m=*/static_cast<int32_t*>(nullptr),                                                      \
            subwarps_per_block,                                                                               \
            hidden_dim_num_groups,                                                                            \
            scale_expert_stride,                                                                              \
            scale_hidden_stride,                                                                              \
            num_tokens_per_expert);                                                                           \
  } while (0)

#define INTERLEAVED_LAUNCH_KERNEL(GROUP_SIZE, T, DST_DTYPE)                                                  \
  do {                                                                                                       \
    constexpr int THREADS_PER_SUBWARP = GROUP_SIZE / 16;                                                     \
    TORCH_CHECK(THREADS_PER_SUBWARP * INPUT_PRIMARY_VEC_NUM_BYTES == group_size * sizeof(T));                \
    using dst_dtype_info = DtypeInfo<DST_DTYPE>;                                                             \
    CHECK_EQ(dst_dtype_info::MIN, min_8bit);                                                                 \
    CHECK_EQ(dst_dtype_info::MAX, max_8bit);                                                                 \
    INTERLEAVED_LAUNCH_KERNEL_INNER(GROUP_SIZE, THREADS_PER_SUBWARP, T, DST_DTYPE);                          \
  } while (0)

#define INTERLEAVED_LAUNCH_KERNEL_OUTER(...)                \
  switch (group_size) {                                     \
    case 16: INTERLEAVED_LAUNCH_KERNEL(16, __VA_ARGS__); break; \
    case 32: INTERLEAVED_LAUNCH_KERNEL(32, __VA_ARGS__); break; \
    case 64: INTERLEAVED_LAUNCH_KERNEL(64, __VA_ARGS__); break; \
    case 128: INTERLEAVED_LAUNCH_KERNEL(128, __VA_ARGS__); break; \
    default: TORCH_CHECK(false, "Unsupported group_size");  \
  }

  DISPATCH_PYTORCH_DTYPE_TO_CTYPE_FP16(input.scalar_type(), scalar_t, [&] {
    if (dst_type == at::ScalarType::Char) {
      INTERLEAVED_LAUNCH_KERNEL_OUTER(scalar_t, int8_t);
      return true;
    } else if (dst_type == at::ScalarType::Float8_e4m3fn) {
      INTERLEAVED_LAUNCH_KERNEL_OUTER(scalar_t, __br_fp8_e4m3);
      return true;
    }
    return false;
  });

#undef INTERLEAVED_LAUNCH_KERNEL_OUTER
#undef INTERLEAVED_LAUNCH_KERNEL
#undef INTERLEAVED_LAUNCH_KERNEL_INNER
}
